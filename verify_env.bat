@echo off
:: ==============================================================================
:: 교육장 PC 환경변수 및 명령어 동작 검증 도구
:: ==============================================================================
title 교육장 PC 환경 검증 도구
chcp 65001 >nul
cls

echo ==============================================================================
echo                 [교육장 PC 전역 명령어 동작 검증]
echo ==============================================================================
echo.
echo 새 CMD 세션에서 전역 환경변수(PATH) 및 명령어 실행을 테스트합니다...
echo.

:: 1. Python 검증
echo [1/4] Python 명령어 테스트:
python --version 2>nul
if %errorlevel% equ 0 (
    echo   -^> [성공] Python 명령어가 정상 인식됩니다.
) else (
    echo   -^> [실패] Python 명령어를 찾을 수 없습니다. (재부팅 또는 PATH 확인 필요)
)
echo.

:: 2. VS Code 검증
echo [2/4] VS Code (code) 명령어 테스트:
call code -v 2>nul
if %errorlevel% equ 0 (
    echo   -^> [성공] code 명령어가 정상 인식됩니다.
) else (
    echo   -^> [실패] code 명령어를 찾을 수 없습니다.
)
echo.

:: 3. Docker 검증
echo [3/4] Docker 명령어 테스트:
docker --version 2>nul
if %errorlevel% equ 0 (
    echo   -^> [성공] docker 명령어가 정상 인식됩니다.
) else (
    echo   -^> [실패] docker 명령어를 찾을 수 없습니다.
)
echo.

:: 4. WSL 검증
echo [4/4] WSL (wsl) 명령어 및 배포판 상태 테스트:
wsl.exe -l -v 2>nul
if %errorlevel% equ 0 (
    echo   -^> [성공] WSL 명령어가 정상 인식됩니다.
) else (
    echo   -^> [실패] WSL 명령어를 찾을 수 없습니다.
)
echo.

echo ==============================================================================
echo 검증 완료. 창을 닫으려면 아무 키나 누르세요.
echo ==============================================================================
pause >nul
